# Backend (admin-panel ham shu domenni ishlatadi)
NEXT_PUBLIC_API_URL=https://api.botspace.uz
# Prod gateway rewrites /api/v2 -> new Go backend's /api/v1; leave unset
# locally to keep hitting the backend's real /api/v1 directly.
NEXT_PUBLIC_API_PREFIX=/api/v2

# Telegram auth bot username (login linki uchun: t.me/<bot>)
NEXT_PUBLIC_TELEGRAM_BOT=botmother_authbot

# Bot constructor (iframe embed)
NEXT_PUBLIC_CONSTRUCTOR_URL=http://localhost:3001

# Site URL (footer va meta uchun)
NEXT_PUBLIC_SITE_URL=http://localhost:3010

# Session cookie nomi va JWT secret
SESSION_COOKIE_NAME=bm_session
SESSION_SECRET=change-me-to-a-32-char-secret-string

# Constructor handover token secret — constructor servisining HANDOVER_SECRET bilan AYNAN BIR XIL
HANDOVER_SECRET=change-me-to-a-32-char-secret-string

# Google OAuth client ID
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Default locale (uz | en | ru)
NEXT_PUBLIC_DEFAULT_LOCALE=uz
